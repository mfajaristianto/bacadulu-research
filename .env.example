APP_NAME="BacaDulu Research"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bacadulu_research
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

BACADULU_ADMIN_PATH=panel-adminbaca-research
ADMIN_NAME="BacaDulu Administrator"
ADMIN_EMAIL=
# Recommended: run `php artisan research:admin-password-hash` and paste the
# result here in SINGLE quotes (the hash contains "$"). Leave ADMIN_PASSWORD empty.
ADMIN_PASSWORD_HASH=
# Legacy plaintext fallback, ignored once ADMIN_PASSWORD_HASH is set.
ADMIN_PASSWORD=

RESEARCH_PROFILE_GATE=80
RESEARCH_REQUIRE_EMAIL_VERIFICATION=false

# ============================================================
# AI PROVIDER
# ============================================================

# mock   = deterministic local answers built from real evidence (no API cost)
# openai = OpenAI Responses API (requires OPENAI_API_KEY, billed per token)
AI_PROVIDER=mock
AI_MODEL=
AI_TIMEOUT=90
AI_MAX_OUTPUT_TOKENS=3500
AI_CONTEXT_MESSAGES=8

# Server-side only. Never commit a real key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================================
# QUEUE
# ============================================================

QUEUE_CONNECTION=database
RESEARCH_QUEUE_NAME=research
RESEARCH_INGESTION_QUEUE_NAME=ingestion
RESEARCH_LIVE_REFRESH_SECONDS=2

MAIL_MAILER=log
MAIL_FROM_ADDRESS="research@example.com"
MAIL_FROM_NAME="BacaDulu Research"

# ============================================================
# SENTRY ERROR TRACKING
# ============================================================

# DSN masing-masing website/project Sentry.
# Jangan isi DSN production asli ke repository.
SENTRY_LARAVEL_DSN=

SENTRY_ENVIRONMENT=local

# Contoh:
# SENTRY_RELEASE=bacadulu-research@abc1234
SENTRY_RELEASE=

# Error tracking.
SENTRY_SAMPLE_RATE=1.0

# Maintenance-only:
# tidak kirim transaction/performance event.
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0

SENTRY_ENABLE_LOGS=false
SENTRY_SEND_DEFAULT_PII=false